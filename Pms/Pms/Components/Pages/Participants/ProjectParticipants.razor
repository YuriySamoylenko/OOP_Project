@page "/projects/{ProjectId:int}/participants"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Pms.Bll.Interfaces
@using Pms.Core.Entities
@using Pms.Core.Models
@rendermode InteractiveServer

@attribute [Authorize]
@inject IProjectService ProjectService
@inject IParticipantService ParticipantService
@inject UserManager<User> UserManager
@inject INotificationService Notify
@inject NavigationManager Nav

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/projects">Projects</a></li>
            <li class="breadcrumb-item"><a href="/projects/@ProjectId">Project Board</a></li>
            <li class="breadcrumb-item active">Manage Team</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Team Management</h2>
        <button class="btn btn-outline-secondary" @onclick="GoBack">Back to Project</button>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">Add Participant</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Select User</label>
                        <select class="form-select" @bind="newParticipant.UserId">
                            <option value="">-- Choose User --</option>
                            @foreach (var user in allUsers.Where(u => !currentParticipants.Any(p => p.UserId == u.Id)))
                            {
                                <option value="@user.Id">@user.LastName (@user.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isManager" @bind="newParticipant.Manager">
                            <label class="form-check-label" for="isManager">Assign as Manager</label>
                        </div>
                    </div>
                    <button class="btn btn-success w-100" @onclick="AddUserToProject"
                            disabled="@(string.IsNullOrEmpty(newParticipant.UserId))">
                        Add to Project
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold">Current Participants</div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Role</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!currentParticipants.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No participants assigned yet.</td>
                                </tr>
                            }
                            @foreach (var participant in currentParticipants)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@participant.</div>
                                        <small class="text-muted">@participant.UserEmail</small>
                                    </td>
                                    <td>
                                        <span class="badge @(participant.Manager ? "bg-danger" : "bg-info")">
                                            @(participant.Manager ? "Manager" : "Member")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveParticipant(participant.Id)">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    [Parameter] public int ProjectId { get; set; }

    private List<User> allUsers = new();
    private IList<ParticipantModel> currentParticipants = new List<ParticipantModel>();
    private ParticipantModel newParticipant = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        allUsers = UserManager.Users.ToList();

        var participants = await ParticipantService.GetParticipants(ProjectId);

        currentParticipants = participants;

        newParticipant = new ParticipantModel { ProjId = ProjectId };
    }

    private async Task AddUserToProject()
    {
        try
        {
            var authState = await this.AuthStateTask;
            var user = await UserManager.GetUserAsync(authState.User);
            if (user != null)
            {
                await ParticipantService.AddParticipant(newParticipant, user);
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Notify.NotifyError($"Failed to add user: {ex.Message}");
        }
    }

    private async Task RemoveParticipant(int participantId)
    {
        try
        {
            var authState = await this.AuthStateTask;
            var user = await UserManager.GetUserAsync(authState.User);
            if (user != null)
            {
                await ParticipantService.DeleteParticipant(participantId, ProjectId, user);
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Notify.NotifyError($"Failed to remove participant: {ex.Message}");
        }
    }

    private void GoBack() => Nav.NavigateTo($"/projects/{ProjectId}");
}