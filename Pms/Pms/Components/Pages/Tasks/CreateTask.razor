@page "/projects/{ProjectId:int}/tasks/new"
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Pms.Bll.Interfaces
@using Pms.Core.Entities
@using Pms.Core.Models
@rendermode InteractiveServer

@attribute [Authorize]
@inject ISprintService SprintService
@inject UserManager<User> UserManager
@inject INotificationService Notify
@inject ITaskService TaskService
@inject IParticipantService ParticipantService
@inject NavigationManager Nav

<div class="container py-4">
    <h3>Create Task for Project #@ProjectId</h3>
    <hr />

    <div class="card shadow-sm p-4" style="max-width: 800px;">
        <TaskEditor Model="newTask" Sprints="availableSprints" Participants="projectParticipants" OnSave="HandleCreate" />
        <button class="btn btn-link mt-2" @onclick="Cancel">Back to Board</button>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;
    [Parameter] public int ProjectId { get; set; }

    [SupplyParameterFromForm(FormName = "TaskCreateForm")]
    private TaskModel newTask { get; set; } = new();

    private IList<SprintModel> availableSprints = new List<SprintModel>();
    private IList<ParticipantModel> projectParticipants = new List<ParticipantModel>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await this.AuthStateTask;
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            newTask.CreatorId = user.Id;
        }
        newTask.ProjId = ProjectId;
        availableSprints = await SprintService.GetSprints(ProjectId);
        projectParticipants = await ParticipantService.GetParticipants(ProjectId);
    }

    private async Task HandleCreate()
    {
        try
        {
            var authState = await this.AuthStateTask;
            var user = await UserManager.GetUserAsync(authState.User);
            if (user != null)
            {
                await TaskService.CreateTask(newTask, user);
                Nav.NavigateTo($"/projects/{ProjectId}");
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            Notify.NotifyError(ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            Notify.NotifyError(ex.Message);
        }
        catch (Exception)
        {
            Notify.NotifyError("An error occurred while creating the project.");
        }
    }

    private void Cancel() => Nav.NavigateTo($"/projects/{ProjectId}");
}