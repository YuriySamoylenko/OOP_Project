@using Pms.Core.Enums
@using Pms.Core.Models
@using Pms.Core.Entities

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit" FormName="ProjectEntryForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <InputNumber @bind-Value="Model.Id" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Project Name</label>
        <InputText @bind-Value="Model.Name" class="form-control" placeholder="Enter project name..." />
        <ValidationMessage For="@(() => Model.Name)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Short Name:</label>
        <label class="form-label">@Model.Code</label>
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <InputSelect @bind-Value="Model.Status" class="form-select">
            @foreach (var status in Enum.GetValues<Status>())
            {
                <option value="@status">@status</option>
            }
        </InputSelect>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn btn-primary">@ButtonText</button>
    </div>
</EditForm>

@code {
    [Parameter] public ProjectModel Model { get; set; } = new();
    [Parameter] public string ButtonText { get; set; } = "Save";
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public Action OnCancel { get; set; }

    private async Task HandleValidSubmit()
    {
        await OnValidSubmit.InvokeAsync();
    }
}