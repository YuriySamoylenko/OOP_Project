@page "/projects/new"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Pms.Bll.Interfaces
@using Pms.Core.Entities
@using Pms.Core.Models
@rendermode InteractiveServer

@attribute [Authorize]
@inject UserManager<User> UserManager
@inject IProjectService ProjectService
@inject NavigationManager Nav
@inject INotificationService Notify

<div class="container mt-4">
    <h3>Create New Project</h3>
    <hr />

    <div class="card shadow-sm p-4" style="max-width: 600px;">
        <ProjectEditor Model="newProject"
                       ButtonText="Create Project"
                       OnValidSubmit="SaveProject"
                       OnCancel="GoBack" />
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    private ProjectModel newProject = new();

    private async Task SaveProject()
    {
        try
        {
            var authState = await this.AuthStateTask;
            var user = await UserManager.GetUserAsync(authState.User);
            if (user != null)
            {
                await ProjectService.CreateProject(newProject, user);
                Nav.NavigateTo("/projects");
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            Notify.NotifyError(ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            Notify.NotifyError(ex.Message);
        }
        catch (Exception)
        {
            Notify.NotifyError("An error occurred while creating the project.");
        }
    }

    private void GoBack() => Nav.NavigateTo("/projects");
}